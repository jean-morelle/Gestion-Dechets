# Protection si le serveur pointe sur ce dossier au lieu de public/ (cas de XAMPP) :
# aucun fichier du projet (.env, code, base…) n'est servi directement,
# toutes les requêtes passent par public/.
# En production, le serveur doit de toute façon pointer sur public/ (voir docs/deploiement.md).

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
