# CollectPlus Togo — modèle de configuration
# Copier ce fichier en .env puis lancer : php artisan key:generate
# Les valeurs ci-dessous sont celles de la PRODUCTION. En local, voir les commentaires « local ».

APP_NAME="CollectPlus Togo"
APP_ENV=production            # local : local
APP_KEY=
APP_DEBUG=false               # local : true. Ne JAMAIS mettre true en production (affiche le code et les secrets en cas d'erreur)
APP_URL=https://collectplus.example.tg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # un fichier de journal par jour, conservé 14 jours
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning             # local : debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestiondechetsdb
DB_USERNAME=collectplus       # un compte dédié, pas root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true    # local sans HTTPS : false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Envoi des e-mails (mot de passe oublié…)
# local : MAIL_MAILER=log → les e-mails sont écrits dans storage/logs/laravel.log
# production : serveur SMTP de la mairie ou d'un prestataire (Brevo, Mailjet, Gmail Workspace…)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.tg
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ne-pas-repondre@collectplus.example.tg"
MAIL_FROM_NAME="${APP_NAME}"

# Connexion avec Google (facultatif) — voir docs/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"

# Organisme exploitant (pages Confidentialité et Conditions d'utilisation)
EXPLOITANT_NOM="Mairie de …"
EXPLOITANT_ADRESSE=
EXPLOITANT_EMAIL=
EXPLOITANT_TELEPHONE=
HEBERGEUR=
DECLARATION_IPDCP=
