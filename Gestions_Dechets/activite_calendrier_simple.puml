@startuml
!theme plain
title Diagramme d'Activité - Consulter le Calendrier de Collecte

start

:Citoyen authentifié;
:Cliquer sur "Calendrier de collecte";
:Récupérer les données du calendrier;
:Afficher le calendrier du mois en cours;

repeat
  :Consulter le calendrier;
  
  if (Action souhaitée ?) then (Navigation)
    if (Mois précédent) then (Oui)
      :Cliquer sur "Mois précédent";
      :Récupérer les données du mois précédent;
      :Mettre à jour l'affichage;
    elseif (Mois suivant) then (Oui)
      :Cliquer sur "Mois suivant";
      :Récupérer les données du mois suivant;
      :Mettre à jour l'affichage;
    elseif (Date spécifique) then (Oui)
      :Utiliser la fonction de recherche de date;
      :Saisir une date spécifique;
      :Récupérer les données pour cette date;
      :Afficher directement le mois et la date;
    endif
  elseif (Consultation détail) then (Oui)
    :Cliquer sur un jour de collecte;
    :Afficher les détails (type, horaires, instructions);
    
    if (Plus de détails ?) then (Oui)
      :Cliquer sur "Plus de détails";
      :Afficher popup ou nouvelle page;
      :Informations complètes;
    endif
  elseif (Filtrage) then (Oui)
    if (Filtre par type) then (Oui)
      :Sélectionner type de déchets;
      :Appliquer le filtre;
      :Mettre à jour l'affichage;
    elseif (Filtre par zone) then (Oui)
      :Sélectionner zone/quartier;
      :Appliquer le filtre de zone;
      :Afficher uniquement les collectes de la zone;
    endif
  endif

repeat while (Continuer à consulter ?) is (Oui)
-> Non;

if (Calendrier vide ?) then (Oui)
  :Afficher "Aucune collecte planifiée";
  :Proposer de changer de mois;
else (Non)
  :Continuer la consultation normale;
endif

stop

@enduml
